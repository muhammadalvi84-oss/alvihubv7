-- 🔇 SILENT AIM
-- ==============================================
local function hookSilentAim()
    SilentAimOriginal = ReplicatedStorage.RemoteEvent or ReplicatedStorage.SendEvent
end

-- Silent Aim untuk Veil / Serangan Jarak Jauh
local function getSilentTargetVeil()
    local t, d = getNearestSurvivor(200)
    if not t or not t.Character then return nil end
    return t.Character:FindFirstChild("Head") or t.Character:FindFirstChild("HumanoidRootPart")
end

-- Silent Aim untuk Pistol
local function getSilentTargetPistol()
    local t, d = getNearestSurvivor(300)
    if not t or not t.Character then return nil end
    return t.Character:FindFirstChild("Head") or t.Character:FindFirstChild("HumanoidRootPart")
end

-- Tangkap pengiriman peluru / serangan
local function processSilentAim(remote, args)
    if not args or not args[1] then return args end
    
    local newArgs = {unpack(args)}
    
    -- Silent Aim Veil
    if Settings.SilentAimVeil and string.find(string.lower(remote.Name), "veil") or string.find(string.lower(remote.Name), "shoot") then
        local target = getSilentTargetVeil()
        if target then
            if typeof(args[1]) == "Vector3" then
                local offset = Settings.SilentAimRandomize and Vector3.new(math.random(-5,5)/10, math.random(-5,5)/10, math.random(-5,5)/10) or Vector3.new()
                newArgs[1] = target.Position + offset
            end
        end
    end
    
    -- Silent Aim Pistol
    if Settings.SilentAimPistol and string.find(string.lower(remote.Name), "gun") or string.find(string.lower(remote.Name), "pistol") or string.find(string.lower(remote.Name), "bullet") then
        local target = getSilentTargetPistol()
        if target then
            if typeof(args[1]) == "Vector3" then
                local offset = Settings.SilentAimRandomize and Vector3.new(math.random(-3,3)/10, math.random(-3,3)/10, math.random(-3,3)/10) or Vector3.new()
                newArgs[1] = target.Position + offset
            end
        end
    end
    
    return newArgs
end

-- Pantau semua remote
ReplicatedStorage.ChildAdded:Connect(function(child)
    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
        pcall(function()
            child.OnServerEvent:Connect(function(plr, ...)
                if plr ~= LocalPlayer then return end
                local args = {...}
                local newArgs = processSilentAim(child, args)
                if newArgs ~= args then
                    -- Kirim ulang dengan target yang diubah
                    child:FireServer(unpack(newArgs))
                end
            end)
        end)
    end
end)

-- Cek remote yang sudah ada saat dimuat
for _, c in ipairs(ReplicatedStorage:GetChildren()) do
    if c:IsA("RemoteEvent") then
        pcall(function()
            c.OnServerEvent:Connect(function(plr, ...)
                if plr ~= LocalPlayer then return end
                local args = {...}
                local newArgs = processSilentAim(c, args)
                if newArgs ~= args and table.concat(newArgs, ",") ~= table.concat(args, ",") then
                    -- Sudah ditangani
                end
            end)
        end)
    end
end

