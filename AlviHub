-- ⚔️ AUTO PARRY
-- ==============================================
local function getNearestAttacker()
    local root = getLocalRoot()
    if not root then return nil, 1e9 end
    local nearest, dist = nil, Settings.ParryRadius
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isTeamKiller(p) and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - root.Position).Magnitude
                if d < dist then dist = d nearest = p end
            end
        end
    end
    return nearest, dist
end

task.spawn(function()
    while task.wait(0.05) do
        if not Settings.AutoParry then continue end
        local now = os.clock()
        if now - LastParry < Settings.ParryCooldown then continue end
        
        local attacker = getNearestAttacker()
        if attacker then
            LastParry = now
            -- Kirim sinyal parry — sesuaikan dengan nama remote di game
            pcall(function()
                local rem = ReplicatedStorage:FindFirstChild("Remotes")
                if rem and rem:FindFirstChild("Parry") then
                    rem.Parry:FireServer()
                elseif rem and rem:FindFirstChild("Block") then
                    rem.Block:FireServer(true)
                end
            end)
            -- Simulasi tombol parry
            pcall(function()
                UserInputService:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.05)
                UserInputService:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end)
        end
    end
end)

-- ==============================================
-- 🎯 AIMBOT
-- ==============================================
local function getAimbotTarget()
    local center = getScreenCenter()
    local target, minDist = nil, 1e9
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local head = p.Character:FindFirstChild("Head")
        local pos = head and head.Position or hrp and hrp.Position
        if not pos then continue end
        
        local isEnemy = isTeamKiller(p)
        if not isEnemy then continue end
        
        local d = getDistance(pos)
        if d > Settings.AimbotMaxDistance then continue end
        local sc, onScr = worldToScreen(pos)
        if not onScr then continue end
        local scrDist = (sc - center).Magnitude
        if scrDist < minDist then
            minDist = scrDist
            target = pos
        end
    end
    return target
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Settings.AimbotKey and Settings.Aimbot then
        local targetPos = getAimbotTarget()
        if targetPos then
            local goal = CFrame.new(CurrentCamera.CFrame.Position, targetPos)
            TweenService:Create(CurrentCamera, TweenInfo.new(Settings.AimbotSmoothness, Enum.EasingStyle.Sine), {CFrame = goal}):Play()
        end
    end
end)

