-- ==============================================
-- 👁️ SISTEM ESP
-- ==============================================
local function hapusESP(char)
    if not char then return end
    if char:FindFirstChild("ESP_Highlight") then char.ESP_Highlight:Destroy() end
    if char:FindFirstChild("ESP_Nama") then char.ESP_Nama:Destroy() end
end

local function buatESP(p)
    if not Settings.ESP_Master or p == LocalPlayer then return end
    if not p.Character then return end
    local char = p.Character
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not head or not root then return end
    
    local isK = isTeamKiller(p)
    local show = (isK and Settings.ESP_Killer) or (not isK and Settings.ESP_Survivor)
    if not show then hapusESP(char) return end
    
    local color = isK and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 255, 80)
    local tag = isK and "[KILLER] " or "[TEMAN] "
    
    -- Highlight
    if Settings.ESP_Highlight then
        local hl = char:FindFirstChild("ESP_Highlight") or Instance.new("Highlight")
        hl.Name = "ESP_Highlight"
        hl.Parent = char
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 1
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    else
        if char:FindFirstChild("ESP_Highlight") then char.ESP_Highlight:Destroy() end
    end
    
    -- Nama & Jarak
    if Settings.ESP_Name then
        local bg = head:FindFirstChild("ESP_Nama") or Instance.new("BillboardGui")
        bg.Name = "ESP_Nama"
        bg.Parent = head
        bg.AlwaysOnTop = true
        bg.Size = UDim2.new(0, 200, 0, 30)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        
        local lbl = bg:FindFirstChild("Label") or Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.Parent = bg
        lbl.Size = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.TextColor3 = color
        lbl.TextStrokeTransparency = 0
        
        local text = tag .. p.DisplayName
        if Settings.ESP_Distance then
            local me = getLocalRoot()
            if me then text = text .. " [" .. math.floor((root.Position - me.Position).Magnitude) .. "m]" end
        end
        lbl.Text = text
    else
        if head:FindFirstChild("ESP_Nama") then head.ESP_Nama:Destroy() end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not Settings.ESP_Master then
            for _, p in ipairs(Players:GetPlayers()) do if p.Character then hapusESP(p.Character) end end
            task.wait(1)
            continue
        end
        for _, p in ipairs(Players:GetPlayers()) do pcall(function() buatESP(p) end) end
    end
end)

